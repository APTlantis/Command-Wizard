<Window
    x:Class="CommandWizard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommandWizard"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Aptlantis Command Wizard"
    Width="1080"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    Style="{StaticResource MaterialDesignWindow}"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding
            CanExecute="OnCommandCanExecute"
            Command="{x:Static local:MainWindow.CopyCommand}"
            Executed="OnCopyExecuted" />
        <CommandBinding
            CanExecute="OnCommandCanExecute"
            Command="{x:Static local:MainWindow.GenerateCommand}"
            Executed="OnGenerateExecuted" />
        <CommandBinding Command="{x:Static local:MainWindow.HelpCommand}" Executed="OnHelpExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding
            Key="C"
            Command="{x:Static local:MainWindow.CopyCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="G"
            Command="{x:Static local:MainWindow.GenerateCommand}"
            Modifiers="Control" />
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.HelpCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="16">
        <Menu DockPanel.Dock="Top" />

        <TabControl x:Name="MainTabs">
            <TabItem x:Name="SchemaEditorTab" Header="Schema Editor">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        Fill="{StaticResource BorderBrush}" />

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Schemas" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Grid Width="180">
                                    <TextBox Text="{Binding ToolSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="6,4,0,0"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        IsHitTestVisible="False"
                                        Text="Search tools..."
                                        Visibility="{Binding ToolSearchText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                </Grid>
                                <ComboBox
                                    Width="140"
                                    Margin="8,0,0,0"
                                    ItemsSource="{Binding TagFilters}"
                                    SelectedItem="{Binding SelectedTagFilter}" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            ItemsSource="{Binding ToolsView}"
                            SelectedItem="{Binding SelectedTool}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,3,6,0"
                                                Fill="{Binding StatusBrush}" />
                                            <TextBlock Foreground="{Binding StatusBrush}" Text="{Binding StatusText}" />
                                        </StackPanel>
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,6,6"
                                                        Padding="6,2"
                                                        Background="{Binding ColorBrush}"
                                                        CornerRadius="10">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="White"
                                                            Text="{Binding Name}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button Click="OnNewSchemaClicked" Content="New Schema" />
                            <Button
                                Margin="0,8,0,0"
                                Click="OnImportFromHelpClicked"
                                Content="Import From Help..." />
                            <Button
                                Margin="0,8,0,0"
                                Click="OnDeleteSchemaClicked"
                                Content="Delete Schema" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Schema Details" />

                            <Border
                                Margin="0,8,0,0"
                                Padding="8"
                                Background="#FFF4CE"
                                BorderBrush="#FFCC00"
                                BorderThickness="1"
                                Visibility="{Binding SelectedTool.IsImportedUnsaved, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="Imported (unsaved). " />
                                    <TextBlock Text="{Binding SelectedTool.ImportSummary}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Tool Name" />
                                <TextBox Text="{Binding SelectedTool.ToolName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Description" />
                                <TextBox Text="{Binding SelectedTool.ToolDescription, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Executable Path (optional)" />
                                <TextBox Text="{Binding SelectedTool.ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Installed Command Name (optional)" />
                                <TextBox Text="{Binding SelectedTool.InstalledName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Expander
                                Margin="0,12,0,0"
                                Header="Actions"
                                IsExpanded="True">
                                <StackPanel Margin="0,6,0,0">
                                    <DataGrid
                                        MaxHeight="180"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding SelectedTool.Actions}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedActionForEdit}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Name" />
                                            <DataGridTextColumn
                                                Width="2*"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Description" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button
                                            Width="110"
                                            Click="OnAddActionClicked"
                                            Content="Add Action" />
                                        <Button
                                            Width="90"
                                            Margin="8,0,0,0"
                                            Click="OnRemoveActionClicked"
                                            Content="Remove" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander
                                Margin="0,12,0,0"
                                Header="Arguments"
                                IsExpanded="True">
                                <StackPanel Margin="0,6,0,0">
                                    <DataGrid
                                        MaxHeight="220"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding SelectedTool.Schema.Arguments}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedArgumentForEdit}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Flag, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Flag" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Long, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Long" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Type" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding ValueStyleText, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Value Style" />
                                            <DataGridTextColumn
                                                Width="2*"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Description" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button
                                            Width="120"
                                            Click="OnAddArgumentClicked"
                                            Content="Add Argument" />
                                        <Button
                                            Width="90"
                                            Margin="8,0,0,0"
                                            Click="OnRemoveArgumentClicked"
                                            Content="Remove" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander
                                Margin="0,12,0,0"
                                Header="Parameters"
                                IsExpanded="True">
                                <StackPanel Margin="0,6,0,0">
                                    <DataGrid
                                        MaxHeight="180"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding SelectedTool.Schema.Parameters}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedParameterForEdit}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Name" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Type" />
                                            <DataGridCheckBoxColumn
                                                Width="Auto"
                                                Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Required" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button
                                            Width="120"
                                            Click="OnAddParameterClicked"
                                            Content="Add Parameter" />
                                        <Button
                                            Width="90"
                                            Margin="8,0,0,0"
                                            Click="OnRemoveParameterClicked"
                                            Content="Remove" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander
                                Margin="0,12,0,0"
                                Header="Tags"
                                IsExpanded="True">
                                <StackPanel Margin="0,6,0,0">
                                    <!--  Tag list: name editable, color shown as a dot  -->
                                    <DataGrid
                                        MaxHeight="160"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding SelectedTool.Tags}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedTagForEdit}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Header="Name" />
                                            <DataGridTemplateColumn Width="36" Header="">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Ellipse
                                                            Width="16"
                                                            Height="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding ColorBrush}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!--  Color swatch picker: click to apply to selected tag  -->
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="11"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Text="Pick color for selected tag" />
                                        <ItemsControl ItemsSource="{Binding TagPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Width="28"
                                                        Height="28"
                                                        Margin="0,0,6,0"
                                                        Click="OnTagColorSwatchClicked"
                                                        Tag="{Binding Color}"
                                                        ToolTip="{Binding Name}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid>
                                                                    <Ellipse
                                                                        Width="22"
                                                                        Height="22"
                                                                        Fill="{Binding Brush}"
                                                                        Stroke="{StaticResource BorderBrush}"
                                                                        StrokeThickness="2" />
                                                                    <Ellipse
                                                                        x:Name="Hover"
                                                                        Width="22"
                                                                        Height="22"
                                                                        Fill="White"
                                                                        Opacity="0" />
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Hover" Property="Opacity" Value="0.15" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Hover" Property="Opacity" Value="0.3" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Button
                                            Width="100"
                                            Click="OnAddTagClicked"
                                            Content="Add Tag" />
                                        <Button
                                            Width="90"
                                            Margin="8,0,0,0"
                                            Click="OnRemoveTagClicked"
                                            Content="Remove" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Notes" />
                                <TextBox
                                    Height="120"
                                    AcceptsReturn="True"
                                    Text="{Binding SelectedTool.Notes, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                <Button
                                    Width="120"
                                    Click="OnSaveSchemaClicked"
                                    Content="Save Schema" />
                                <Button
                                    Width="170"
                                    Margin="8,0,0,0"
                                    Click="OnDiscardImportedClicked"
                                    Content="Discard Imported Schema"
                                    Visibility="{Binding SelectedTool.IsImportedUnsaved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button
                                    Width="110"
                                    Margin="8,0,0,0"
                                    Click="OnViewLogClicked"
                                    Content="View Log" />
                                <Button
                                    Width="160"
                                    Margin="8,0,0,0"
                                    Click="OnCopyToolClicked"
                                    Content="Copy Tool to App Dir" />
                                <Button
                                    Width="170"
                                    Margin="8,0,0,0"
                                    Click="OnAddToolsDirToPathClicked"
                                    Content="Add Tools Dir to PATH" />
                                <TextBlock Margin="12,4,0,0" Text="{Binding SelectedTool.SourcePath}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="WizardTab" Header="Wizard">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        Fill="{StaticResource BorderBrush}" />

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Tools" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Grid Width="180">
                                <TextBox Text="{Binding ToolSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="6,4,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsHitTestVisible="False"
                                    Text="Search tools..."
                                    Visibility="{Binding ToolSearchText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            </Grid>
                            <ComboBox
                                Width="140"
                                Margin="8,0,0,0"
                                ItemsSource="{Binding TagFilters}"
                                SelectedItem="{Binding SelectedTagFilter}" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding ToolsView}"
                        SelectedItem="{Binding SelectedTool}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Margin="0,3,6,0"
                                            Fill="{Binding StatusBrush}" />
                                        <TextBlock Foreground="{Binding StatusBrush}" Text="{Binding StatusText}" />
                                    </StackPanel>
                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,6,6"
                                                    Padding="6,2"
                                                    Background="{Binding ColorBrush}"
                                                    CornerRadius="10">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="White"
                                                        Text="{Binding Name}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer
                        Grid.Row="1"
                        Grid.Column="2"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Command Setup" />

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Task Label (optional)" />
                                <TextBox Text="{Binding TaskLabel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Action (optional)" />
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding SelectedTool.Actions}"
                                    SelectedItem="{Binding SelectedAction}" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Options" />
                                <ItemsControl ItemsSource="{Binding SelectedTool.Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsSelected}"
                                                    ToolTip="{Binding Description}"
                                                    Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBox
                                                    Grid.Column="0"
                                                    Width="200"
                                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip="{Binding Description}"
                                                    Visibility="{Binding IsBoolean, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Text="{Binding DisplayName}"
                                                    ToolTip="{Binding Description}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Width="60"
                                                    Margin="12,0,0,0"
                                                    Click="OnEditOptionClicked"
                                                    Content="Edit" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Parameters" />
                                <ItemsControl ItemsSource="{Binding SelectedTool.Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Parameter.Name}" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,16,0,0"
                        Padding="12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="Command Preview" />
                                <TextBox
                                    Margin="0,6,0,0"
                                    IsReadOnly="True"
                                    Text="{Binding CommandPreview, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="100"
                                Margin="12,0,0,0"
                                Command="{x:Static local:MainWindow.CopyCommand}"
                                Content="Copy" />
                            <Button
                                Grid.Column="2"
                                Width="100"
                                Margin="12,0,0,0"
                                Command="{x:Static local:MainWindow.GenerateCommand}"
                                Content="Save" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="FavoritesTab" Header="Favorites">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Favorites Quick Copy" />
                        <Grid
                            Grid.Column="1"
                            Width="180"
                            Margin="0,0,8,0">
                            <TextBox Text="{Binding FavoriteSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="6,4,0,0"
                                Foreground="{StaticResource TextMutedBrush}"
                                IsHitTestVisible="False"
                                Text="Search favorites..."
                                Visibility="{Binding FavoriteSearchText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        </Grid>
                        <ComboBox
                            Grid.Column="2"
                            Width="150"
                            Margin="0,0,8,0"
                            ItemsSource="{Binding FavoriteTagFilters}"
                            SelectedItem="{Binding SelectedFavoriteTagFilter}" />
                        <Button
                            Grid.Column="3"
                            Width="90"
                            Margin="0,0,8,0"
                            Click="OnExportFavoritesClicked"
                            Content="Export" />
                        <Button
                            Grid.Column="4"
                            Width="90"
                            Click="OnClearFavoritesClicked"
                            Content="Clear All" />
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding FavoritesView}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontFamily="Consolas"
                                                Text="{Binding Command}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding ToolActionLabel}" />
                                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="6,2"
                                                            Background="{Binding ColorBrush}"
                                                            CornerRadius="10">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="White"
                                                                Text="{Binding Name}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="{Binding Task}" />
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="  •  " />
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="{Binding CreatedAtLocal}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Width="80"
                                            Margin="12,0,0,0"
                                            Click="OnCopyFavoriteClicked"
                                            Content="Copy" />
                                        <Button
                                            Grid.Column="2"
                                            Width="80"
                                            Margin="8,0,0,0"
                                            Click="OnRemoveFavoriteClicked"
                                            Content="Remove" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Height="70"
                                AcceptsReturn="True"
                                Text="{Binding PasteCommandText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                            <Button
                                Grid.Column="1"
                                Width="90"
                                Margin="12,0,0,0"
                                Click="OnAddFavoriteClicked"
                                Content="Add" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
