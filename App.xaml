<Application x:Class="CommandWizard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CommandWizard"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Light theme, Blue primary -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="LightBlue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Brand brushes — used in inline layout (Borders, placeholders, etc.)
                MD handles all control implicit styles, so we don't redefine Button/TextBox/etc.
            -->
            <SolidColorBrush x:Key="PrimaryBrush"         Color="#1565C0"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush"     Color="#0D47A1"/>
            <SolidColorBrush x:Key="AccentBrush"          Color="#1E88E5"/>
            <SolidColorBrush x:Key="BackgroundBrush"      Color="#F5F5F5"/>
            <SolidColorBrush x:Key="SurfaceBrush"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#EEEEEE"/>
            <SolidColorBrush x:Key="BorderBrush"          Color="#BDBDBD"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#212121"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#616161"/>
            <SolidColorBrush x:Key="TextMutedBrush"       Color="#9E9E9E"/>

            <!-- Primary action button: filled blue -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Muted/secondary button: text style, no background -->
            <Style x:Key="MutedButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
